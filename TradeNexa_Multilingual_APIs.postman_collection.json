    {
      "name": "7. Translation Utilities & Testing APIs",
      "item": [
        {
          "name": "Translate Text Payload Directly",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Industrial Water Pump\",\n  \"description\": \"High quality industrial water pump for factories.\",\n  \"source_language\": \"en\",\n  \"target_languages\": [\"hi\", \"gu\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/test/translate-product",
              "host": ["{{base_url}}"],
              "path": ["test", "translate-product"]
            },
            "description": "Directly translates text payload into target languages (Hindi & Gujarati)."
          }
        },
        {
          "name": "Get Supported Languages List",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/test/translation-languages",
              "host": ["{{base_url}}"],
              "path": ["test", "translation-languages"]
            },
            "description": "Returns list of supported language codes and their display names."
          }
        }
      ]
    }
