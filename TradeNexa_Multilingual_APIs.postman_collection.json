                  "key": "lang",
                  "value": "gu"
                }
              ]
            },
            "description": "Fetches full product details. All basic details, pricing units, stock status, seller company, seller address, specifications, search tags, and warranty are translated."
          }
        },
        {
          "name": "Get Trending Products",
