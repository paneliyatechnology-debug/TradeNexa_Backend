            "description": "Fetches trending products with automatic translation."
          }
        },
        {
          "name": "Get Related Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "gu",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/2/related?lang=gu&limit=4",
              "host": ["{{base_url}}"],
              "path": ["products", "2", "related"],
              "query": [
                {
                  "key": "lang",
                  "value": "gu"
                },
                {
                  "key": "limit",
                  "value": "4"
                }
              ]
            },
            "description": "Fetches related products for a product ID translated into the selected language."
          }
        }
      ]
    },
    {
