{
  "info": {
    "_postman_id": "tradenexa-multilingual-v1-collection",
    "name": "TradeNexa - Multilingual & Translation APIs",
    "description": "Complete collection of multilingual-enabled APIs for TradeNexa.\n\n### How to Pass Language:\nYou can request data in **English (`en`)**, **Hindi (`hi`)**, or **Gujarati (`gu`)** using either:\n1. **Query Parameter**: `?lang=hi` or `?lang=gu` or `?lang=en`\n2. **Header**: `x-language: hi` (or `gu`, `en`) or standard `Accept-Language: hi`\n\n### Multilingual Features:\n- **Products**: Full detail, list cards, search, unit, status, address, specs, tags.\n- **Categories & Subcategories**: Name, parent/child names, multilingual search.\n- **User & Seller Profiles**: Company name, business type, description/about, industry, city, state, country, designation.\n- **Notifications**: Inbox list notification titles and messages translated.\n- **Login Devices**: Active devices and browser descriptions translated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Categories (Multilingual)",
      "item": [
        {
          "name": "Get Categories List (with Language & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "hi",
                "description": "Target language: 'en', 'hi', 'gu'",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories?lang=hi&search=कार&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["categories"],
              "query": [
                {
                  "key": "lang",
                  "value": "hi",
                  "description": "Language code: 'en' | 'hi' | 'gu'"
                },
                {
                  "key": "search",
                  "value": "कार",
                  "description": "Multilingual search query (e.g. 'कार', 'ખેતી', 'farming')"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve categories list. Category names are translated automatically to the requested language."
          }
        },
        {
          "name": "Get Category By ID (with Subcategories translated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "gu",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories/3?lang=gu",
              "host": ["{{base_url}}"],
              "path": ["categories", "3"],
              "query": [
                {
                  "key": "lang",
                  "value": "gu"
                }
              ]
            },
            "description": "Retrieve category details and all child subcategories translated."
          }
        },
        {
          "name": "Get Subcategories by Category ID (with Language & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "hi",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories/3/subcategories?lang=hi&search=इंजन&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["categories", "3", "subcategories"],
              "query": [
                {
                  "key": "lang",
                  "value": "hi"
                },
                {
                  "key": "search",
                  "value": "इंजन"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieve subcategories of a category with translation and multilingual search."
          }
        },
        {
          "name": "Get Subcategory Detail By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "gu",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories/3/subcategories/4?lang=gu",
              "host": ["{{base_url}}"],
              "path": ["categories", "3", "subcategories", "4"],
              "query": [
                {
                  "key": "lang",
                  "value": "gu"
                }
              ]
            },
            "description": "Retrieve single subcategory detail with parent category translated."
          }
        }
      ]
    },
    {
      "name": "2. Products (Buyer Side - Multilingual)",
