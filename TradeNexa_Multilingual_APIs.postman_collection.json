            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "x-language",
                "value": "gu",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/profile?lang=gu",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"],
              "query": [
                {
                  "key": "lang",
                  "value": "gu",
                  "description": "'en' | 'hi' | 'gu'"
                }
              ]
            },
            "description": "Fetches authenticated user profile. Full name, company name, business type, industry, description, city, state, country, and address lines are translated."
          }
        },
        {
