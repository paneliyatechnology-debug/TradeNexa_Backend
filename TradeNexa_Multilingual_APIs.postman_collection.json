            ],
            "url": {
              "raw": "{{base_url}}/products?lang=hi&search=पेट्रोल&page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "lang",
                  "value": "hi",
                  "description": "'en' | 'hi' | 'gu'"
                },
                {
                  "key": "search",
                  "value": "पेट्रोल",
                  "description": "Multilingual query (English / Hindi / Gujarati)"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Fetches product cards list. Name, unit, category, subcategory, seller name, city, state, country, and status are translated."
          }
        },
        {
          "name": "Get Product Full Detail By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-language",
                "value": "gu",
